def regression(df):


    features=[

        "innovation",

        "education",

        "entrepreneurship",

        "infrastructure",

        "sustainability"

    ]


    X=df[features]

    y=df["final_GDP"]


    X=sm.add_constant(X)


    model=sm.OLS(
        y,
        X
    ).fit()



    print(
        model.summary()
    )



def vif_test(df):


    X=df[

        [

        "innovation",

        "education",

        "entrepreneurship",

        "infrastructure",

        "sustainability"

        ]

    ]


    vif=pd.DataFrame()


    vif["variable"]=X.columns


    vif["VIF"]=[

        variance_inflation_factor(
            X.values,
            i
        )

        for i in range(
            X.shape[1]
        )

    ]


    print(
        "\nVIF TEST"
    )

    print(vif)



