def run_simulations(
    innovation_rate=.05
):


    results=[]


    for i in range(
        SIMULATIONS
    ):


        model=EconomicDigitalTwin(
            innovation_rate
        )


        output=model.run()


        final=output[-1]


        results.append({

            "simulation":
            i,

            "final_GDP":
            final["GDP"],

            "innovation":
            final["Innovation"]

        })


        logging.info(
            f"Simulation {i+1}/{SIMULATIONS}"
        )


    return pd.DataFrame(
        results
    )



# ============================================================
# STATISTICAL ANALYSIS
# ============================================================


def regression(results):


    X=sm.add_constant(
        results[
            ["innovation"]
        ]
    )


    y=results[
        "final_GDP"
    ]


    model=sm.OLS(
        y,
        X
    ).fit()


    print(
        model.summary()
    )


    return model




# ============================================================
# MACHINE LEARNING
# ============================================================


def machine_learning(results):


    X=results[
        ["innovation"]
    ]

    y=results[
        "final_GDP"
    ]


    X_train,X_test,y_train,y_test=train_test_split(

        X,
        y,
        test_size=.2,
        random_state=42

    )


    model=RandomForestRegressor(
        n_estimators=200,
        random_state=42
    )


    model.fit(
        X_train,
        y_train
    )


    prediction=model.predict(
        X_test
    )


    print("\nMachine Learning Results")

    print(
        "MAE:",
        mean_absolute_error(
            y_test,
            prediction
        )
    )


    print(
        "RMSE:",
        np.sqrt(
            mean_squared_error(
                y_test,
                prediction
            )
        )
    )


    print(
        "R2:",
        r2_score(
            y_test,
            prediction
        )
    )



# ============================================================
# SENSITIVITY ANALYSIS
# ============================================================


def sensitivity():

    scenarios={

        "Low Innovation":
        .02,

        "Baseline":
        .05,

        "High Innovation":
        .10

    }


    results=[]


    for name,value in scenarios.items():

        data=run_simulations(
            value
        )


        results.append({

            "Scenario":
            name,

            "Average GDP":
            data.final_GDP.mean()

        })


    return pd.DataFrame(
        results
    )



