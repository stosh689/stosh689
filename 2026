class EconomicDigitalTwin:


    def __init__(
        self,
        innovation_rate=0.05
    ):

        self.gdp=2000

        self.innovation_rate=innovation_rate


        self.workers=[
            Worker()
            for _ in range(WORKERS)
        ]


        self.companies=[
            Company()
            for _ in range(COMPANIES)
        ]


        self.investors=[
            Investor()
            for _ in range(INVESTORS)
        ]


        self.government=Government()



    def assign_workers(self):

        for worker in self.workers:

            company=random.choice(
                self.companies
            )

            company.workers.append(
                worker
            )



    def simulate_year(self):


        self.government.stimulate(
            self.workers,
            self.companies
        )


        for company in self.companies:

            company.research()



        for investor in self.investors:

            investor.invest(
                random.choice(
                    self.companies
                )
            )


        innovation=np.mean(
            [
                c.innovation
                for c in self.companies
            ]
        )


        growth=(

            0.02 +

            innovation *
            self.innovation_rate

        )


        noise=np.random.normal(
            1,
            .01
        )


        self.gdp *= (
            1 +
            growth *
            noise
        )


        return {

            "GDP":
            self.gdp,

            "Innovation":
            innovation

        }




    def run(self):

        self.assign_workers()

        history=[]


        for year in range(YEARS):

            history.append(
                self.simulate_year()
            )


        return history



