class WorldBank:


    BASE = (
        "https://api.worldbank.org/v2"
    )


    def get_indicator(
        self,
        country,
        indicator,
        start=2000,
        end=2024
    ):


        url = (

            f"{self.BASE}/country/"
            f"{country}/indicator/"
            f"{indicator}"
            f"?date={start}:{end}"
            f"&format=json"
            f"&per_page=100"

        )


        try:

            response = requests.get(
                url,
                timeout=10
            )

            response.raise_for_status()

            data=response.json()


        except Exception as error:

            print(
                "API Error:",
                error
            )

            return None



        if len(data)<2:

            return None



        records=[]


        for item in data[1]:


            records.append({

                "year":
                int(item["date"]),

                "value":
                item["value"]

            })


        return pd.DataFrame(records)



# =========================
# ECONOMIC MODEL
# =========================


class Economy:


    def __init__(self,gdp):


        self.gdp=gdp


        self.innovation=np.random.uniform(
            .30,.80
        )

        self.education=np.random.uniform(
            .40,.90
        )

        self.entrepreneurship=np.random.uniform(
            .30,.80
        )

        self.infrastructure=np.random.uniform(
            .50,.90
        )

        self.sustainability=np.random.uniform(
            .40,.90
        )


    def validate(self):


        variables=[

            self.innovation,
            self.education,
            self.entrepreneurship,
            self.infrastructure,
            self.sustainability

        ]


        for value in variables:

            assert 0 <= value <= 1


        assert self.gdp > 0



    def productivity(self):


        return (

            self.innovation*.38 +

            self.education*.25 +

            self.entrepreneurship*.17 +

            self.infrastructure*.12 +

            self.sustainability*.08

        )



    def step(self):


        self.validate()


        uncertainty=np.random.normal(
            1,
            .015
        )


        growth=(

            .02 +

            self.productivity()
            *
            .05
            *
            uncertainty

        )


        self.gdp*=(
            1+growth
        )



        # innovation feedback loop

        self.innovation += (

            self.education *
            self.entrepreneurship *
            .002

        )


        self.innovation=min(
            self.innovation,
            1
        )


        return self.gdp



# =========================
# MONTE CARLO ENGINE
# =========================


def simulate(
        starting_gdp
):


    results=[]


    for run in range(SIMULATIONS):


        economy=Economy(
            starting_gdp
        )


        history=[]


        for year in range(YEARS):


            history.append(
                economy.step()
            )


        results.append({

            "simulation":
            run,

            "innovation":
            economy.innovation,

            "education":
            economy.education,

            "entrepreneurship":
            economy.entrepreneurship,

            "infrastructure":
            economy.infrastructure,

            "sustainability":
            economy.sustainability,

            "final_GDP":
            economy.gdp,

            "growth_history":
            history

        })


    return pd.DataFrame(results)



