import hashlib
import json
from datetime import datetime



class ProvenanceTracker:


    def create_record(
        self,
        dataset,
        source,
        version
    ):


        identifier = hashlib.sha256(

            dataset.encode()

        ).hexdigest()[:16]


        record={

            "id":
            identifier,


            "dataset":
            dataset,


            "source":
            source,


            "version":
            version,


            "created":
            str(datetime.now())

        }


        with open(
            "data_registry.json",
            "a"
        ) as file:

            file.write(
                json.dumps(record)
                + "\n"
            )


        return record

collaboration/experiment_registry.py

import sqlite3
import json



class ExperimentRegistry:


    def __init__(
        self,
        database="gedt_experiments.db"
    ):

        self.conn=sqlite3.connect(
            database
        )


        self.conn.execute(

        """

        CREATE TABLE IF NOT EXISTS experiments(

        id TEXT,

        parameters TEXT,

        results TEXT

        )

        """

        )



    def save(
        self,
        experiment_id,
        parameters,
        results
    ):


        self.conn.execute(

        "INSERT INTO experiments VALUES (?,?,?)",

        (

        experiment_id,

        json.dumps(parameters),

        json.dumps(results)

        )

        )


        self.conn.commit()

