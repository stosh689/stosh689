examples/innovation_growth/run.py

import yaml
import pandas as pd

from gedt.core.economy import Economy



def load_config():

    with open(
        "experiment.yaml"
    ) as file:

        return yaml.safe_load(
            file
        )



def run():

    config=load_config()


    results=[]


    for i in range(

        config["simulation"]["iterations"]

    ):


        model=Economy(

            config["parameters"]

        )


        output=model.simulate()


        results.append(
            output
        )


    df=pd.DataFrame(
        results
    )


    df.to_csv(
        "results.csv",
        index=False
    )


    print(
        "Experiment complete"
    )



if __name__=="__main__":

    run()

