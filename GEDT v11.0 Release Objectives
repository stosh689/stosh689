"""
GEDT Validation Metrics
"""

import numpy as np


class ValidationMetrics:


    def mae(
        self,
        observed,
        predicted
    ):

        return float(
            np.mean(
                np.abs(
                    np.array(observed)
                    -
                    np.array(predicted)
                )
            )
        )


    def rmse(
        self,
        observed,
        predicted
    ):

        return float(
            np.sqrt(
                np.mean(
                    (
                    np.array(observed)
                    -
                    np.array(predicted)
                    ) ** 2
                )
            )
        )


    def r_squared(
        self,
        observed,
        predicted
    ):

        observed=np.array(observed)
        predicted=np.array(predicted)


        ss_res=np.sum(
            (observed-predicted)**2
        )

        ss_tot=np.sum(
            (observed-np.mean(observed))**2
        )


        return float(
            1 -
            (ss_res/ss_tot)
        )

