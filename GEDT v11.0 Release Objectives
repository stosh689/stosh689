"""
GEDT Agent-Based Population Model
Version 1.0 RC1
"""

from dataclasses import dataclass
import numpy as np



@dataclass
class Agent:

    skill: float
    resources: float
    adaptability: float



class Population:


    def __init__(
        self,
        size: int,
        seed: int = 42
    ):

        np.random.seed(seed)

        self.agents = [

            Agent(

                skill=float(
                    np.random.random()
                ),

                resources=float(
                    np.random.random()
                ),

                adaptability=float(
                    np.random.random()
                )

            )

            for _ in range(size)

        ]


    def innovate(
        self,
        innovation_rate: float
    ):

        for agent in self.agents:

            improvement = (

                innovation_rate

                *

                agent.adaptability

            )


            agent.skill += improvement


            agent.skill = min(
                agent.skill,
                1.0
            )


    def productivity(
        self
    ):

        values = [

            agent.skill *

            agent.resources

            for agent in self.agents

        ]


        return float(
            np.mean(values)
        )

