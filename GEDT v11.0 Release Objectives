import numpy as np


class MegaPopulation:


    def __init__(
        self,
        population_size
    ):


        self.size=population_size


        self.skills=np.random.random(
            population_size
        )


        self.resources=np.random.random(
            population_size
        )



    def evolve(
        self,
        innovation
    ):


        self.skills += (

            innovation *

            0.01

        )


        self.skills=np.clip(

            self.skills,

            0,

            1

        )


    def productivity(
        self
    ):


        return np.sum(

            self.skills *

            self.resources

        )


