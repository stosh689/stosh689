import networkx as nx



class EconomicKnowledgeGraph:


    def __init__(self):

        self.graph=nx.Graph()



    def add_relationship(
        self,
        source,
        target,
        relationship
    ):


        self.graph.add_edge(

            source,

            target,

            relation=relationship

        )



    def connections(
        self,
        node
    ):


        return list(

            self.graph.neighbors(
                node
            )

        )

