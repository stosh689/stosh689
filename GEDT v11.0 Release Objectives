"""
GEDT Distributed Experiment Scheduler
"""

import uuid
import queue
import datetime



class ExperimentScheduler:


    def __init__(self):

        self.jobs=queue.Queue()



    def submit(
        self,
        experiment
    ):


        job_id=str(
            uuid.uuid4()
        )


        job={

            "id":
            job_id,

            "experiment":
            experiment,

            "created":
            str(
                datetime.datetime.now()
            ),

            "status":
            "queued"

        }


        self.jobs.put(
            job
        )


        return job_id



    def next_job(self):

        if not self.jobs.empty():

            return self.jobs.get()

        return None

