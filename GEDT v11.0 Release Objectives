import sqlite3
import json



class ExperimentRegistry:


    def __init__(
        self,
        database="gedt_experiments.db"
    ):

        self.conn=sqlite3.connect(
            database
        )


        self.conn.execute(

        """

        CREATE TABLE IF NOT EXISTS experiments(

        id TEXT,

        parameters TEXT,

        results TEXT

        )

        """

        )



    def save(
        self,
        experiment_id,
        parameters,
        results
    ):


        self.conn.execute(

        "INSERT INTO experiments VALUES (?,?,?)",

        (

        experiment_id,

        json.dumps(parameters),

        json.dumps(results)

        )

        )


        self.conn.commit()

