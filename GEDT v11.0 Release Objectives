import numpy as np



class Calibrator:


    def error(
        self,
        observed,
        simulated
    ):


        return float(

            np.mean(

                np.abs(

                    np.array(observed)

                    -

                    np.array(simulated)

                )

            )

        )



    def score(
        self,
        observed,
        simulated
    ):


        error=self.error(
            observed,
            simulated
        )


        return 1/(1+error)


