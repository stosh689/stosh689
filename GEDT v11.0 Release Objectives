"""
GEDT Statistical Metrics Engine
"""

import numpy as np


class Metrics:


    def mean(
        self,
        values
    ):

        return float(
            np.mean(values)
        )


    def standard_deviation(
        self,
        values
    ):

        return float(
            np.std(values)
        )


    def confidence_interval(
        self,
        values,
        confidence=0.95
    ):

        values=np.array(values)

        mean=np.mean(values)

        std=np.std(values)


        margin=(

            1.96 *

            std /

            np.sqrt(
                len(values)
            )

        )


        return {

            "mean":
            float(mean),


            "lower":
            float(
                mean-margin
            ),


            "upper":
            float(
                mean+margin
            )

        }

