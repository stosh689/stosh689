"""
GEDT Core Validation Experiment
Version: 0.2

Purpose:
Reproducible agent-based simulation benchmark.

Experiment:
Innovation rate impact on productivity.

Outputs:
- Monte Carlo results
- statistical analysis
- research report
"""

import json
import csv
import random
from dataclasses import dataclass, asdict

import numpy as np
from scipy import stats


# =====================================================
# Configuration
# =====================================================

@dataclass
class SimulationConfig:

    population: int = 10000
    years: int = 25
    innovation_rate: float = 0.05
    seed: int = 42



# =====================================================
# Agent Model
# =====================================================

@dataclass
class Agent:

    skill: float
    resources: float
    adaptability: float



class Population:


    def __init__(
        self,
        size,
        seed
    ):

        random.seed(seed)
        np.random.seed(seed)


        self.agents = [

            Agent(

                skill=np.random.random(),

                resources=np.random.random(),

                adaptability=np.random.random()

            )

            for _ in range(size)

        ]



    def innovate(
        self,
        rate
    ):

        for agent in self.agents:

            agent.skill += (

                rate *

                agent.adaptability

            )

            agent.skill = min(
                agent.skill,
                1.0
            )



    def productivity(self):

        values=[

            a.skill *

            a.resources

            for a in self.agents

        ]

        return np.mean(values)



# =====================================================
# Simulation Engine
# =====================================================

class GEDTEngine:


    def run(
        self,
        config
    ):


        population = Population(

            config.population,

            config.seed

        )


        history=[]


        for _ in range(
            config.years
        ):

            population.innovate(

                config.innovation_rate

            )


            history.append(

                population.productivity()

            )


        return {

            "final_productivity":

            float(history[-1]),


            "trajectory":

            history

        }



# =====================================================
# Statistics
# =====================================================

class Statistics:


    def confidence_interval(
        self,
        data
    ):

        mean=np.mean(data)

        error=stats.sem(data)


        interval=stats.t.interval(

            confidence=0.95,

            df=len(data)-1,

            loc=mean,

            scale=error

        )


        return [

            float(interval[0]),

            float(interval[1])

        ]



    def compare(
        self,
        control,
        treatment
    ):


        test=stats.ttest_ind(

            control,

            treatment

        )


        pooled=np.sqrt(

            (

                np.var(control)

                +

                np.var(treatment)

            ) / 2

        )


        effect=(

            np.mean(treatment)

            -

            np.mean(control)

        ) / pooled



        return {


            "control_mean":

            float(np.mean(control)),


            "treatment_mean":

            float(np.mean(treatment)),


            "p_value":

            float(test.pvalue),


            "t_statistic":

            float(test.statistic),


            "effect_size":

            float(effect),


            "confidence_interval":

            self.confidence_interval(
                treatment
            )

        }



# =====================================================
# Experiment Runner
# =====================================================

def run_experiment(
    runs=1000
):

    control=[]

    treatment=[]


    engine=GEDTEngine()


    for seed in range(runs):


        control_config = SimulationConfig(

            innovation_rate=0.02,

            seed=seed

        )


        treatment_config = SimulationConfig(

            innovation_rate=0.10,

            seed=seed

        )


        control.append(

            engine.run(
                control_config
            )
            ["final_productivity"]

        )


        treatment.append(

            engine.run(
                treatment_config
            )
            ["final_productivity"]

        )


    return control, treatment



# =====================================================
# Export
# =====================================================

def save_results(
    results
):

    with open(
        "GEDT_validation_report.json",
        "w"
    ) as file:

        json.dump(

            results,

            file,

            indent=4

        )



# =====================================================
# Main
# =====================================================

if __name__ == "__main__":


    print(
        "Running GEDT Validation..."
    )


    control, treatment = run_experiment(
        1000
    )


    stats_engine=Statistics()


    report=stats_engine.compare(

        control,

        treatment

    )


    save_results(
        report
    )


    print(
        json.dumps(
            report,
            indent=4
        )
    )


    print(
        "\nCompleted GEDT CORE-001"
    )

