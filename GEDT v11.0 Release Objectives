from dataclasses import dataclass
import random
import numpy as np


@dataclass
class SimulationConfig:

    population: int = 10000
    years: int = 25
    seed: int = 42
    innovation_rate: float = 0.05



class GEDTEngine:


    def __init__(
        self,
        config: SimulationConfig
    ):

        self.config = config

        random.seed(
            config.seed
        )

        np.random.seed(
            config.seed
        )


        self.productivity = []


    def initialize(self):

        self.agents = np.random.random(
            self.config.population
        )


    def step(self):

        improvement = (

            self.config.innovation_rate

            *

            np.random.random(
                self.config.population
            )

        )


        self.agents += improvement


        self.agents = np.clip(
            self.agents,
            0,
            1
        )


        output = np.mean(
            self.agents
        )


        self.productivity.append(
            output
        )


    def run(self):

        self.initialize()


        for _ in range(
            self.config.years
        ):

            self.step()


        return {

            "years":
            self.config.years,


            "final_productivity":
            float(
                self.productivity[-1]
            ),


            "trajectory":
            self.productivity

        }


