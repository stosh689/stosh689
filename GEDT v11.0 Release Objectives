class FeatureBuilder:


    def build(
        self,
        data
    ):


        features={}


        for column in data.columns:


            if data[column].dtype != "object":


                features[column]={

                    "mean":
                    float(
                        data[column].mean()
                    ),


                    "std":
                    float(
                        data[column].std()
                    )

                }


        return features

