import numpy as np



def cohens_d(
    group1,
    group2
):


    mean_difference = (

        np.mean(group2)

        -

        np.mean(group1)

    )


    pooled_std = np.sqrt(

        (

        np.var(group1)

        +

        np.var(group2)

        )

        /

        2

    )


    return float(

        mean_difference /

        pooled_std

    )

