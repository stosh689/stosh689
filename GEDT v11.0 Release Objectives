import numpy as np



class EvaluationService:


    def evaluate(
        self,
        observed,
        simulated
    ):


        error=np.mean(

            np.abs(

                observed -

                simulated

            )

        )


        return {

            "MAE":
            float(error),


            "score":
            float(
                1/(1+error)
            )

        }

